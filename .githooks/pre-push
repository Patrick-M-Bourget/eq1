#!/usr/bin/env bash
# Blocks a push whose build or tests fail (.githooks/gate.sh). A rebase rewrites commits without running
# the pre-commit hook, so the pushed commits get the same gate here. It builds and tests the working
# tree, so it requires the pushed commit to be the checked-out one, with nothing uncommitted in what the
# build reads. A push of Markdown changes alone, of a branch deletion or of the pr-assets images isn't gated, nor is a tree the
# gate already passed (the commit hook's, when nothing was rebased since).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

zero=0000000000000000000000000000000000000000
gate=no
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue # deleting a branch
    [ "$remote_ref" = refs/heads/pr-assets ] && continue # images for PR comments (scripts/pr-images.sh)
    base=$remote_sha
    [ "$base" = "$zero" ] && base=$(git merge-base "$local_sha" origin/main 2> /dev/null || echo "")
    changed=$(if [ -n "$base" ]; then git diff --name-only "$base" "$local_sha"; else git show --name-only --format= "$local_sha"; fi)
    printf '%s\n' "$changed" | grep -qv '\.md$' || continue
    if [ "$local_sha" != "$(git rev-parse HEAD)" ]; then
        echo "pre-push: $local_ref isn't checked out here, so its build can't be tested; check it out and push from it" >&2
        exit 1
    fi
    gate=yes
done
[ "$gate" = yes ] || exit 0

dirty=$(git status --porcelain=v1 --untracked-files=all -- engine plugin tests scripts cmake presets assets .githooks '*CMakeLists.txt')
if [ -n "$dirty" ]; then
    echo "pre-push: these differ from the pushed commit; commit them or set them aside first:" >&2
    printf '%s\n' "$dirty" >&2
    exit 1
fi
# The commit hook's gate already built and tested this exact tree (no rebase or amend since).
if [ "$(cat "${BUILD_DIR:-build}/gate-passed-tree" 2> /dev/null)" = "$(git rev-parse 'HEAD^{tree}')" ]; then
    echo "pre-push: this tree already passed the build and tests; not run again"
    exit 0
fi
exec .githooks/gate.sh pre-push
